                <DrawingImage.Drawing>
                    <DrawingGroup>
                        <GeometryDrawing Brush="#2A323F">
                            <GeometryDrawing.Geometry>
                                <RectangleGeometry Rect="0,0,64,64" RadiusX="10" RadiusY="10"/>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <GeometryDrawing Brush="#46505F">
                            <GeometryDrawing.Geometry>
                                <PathGeometry Figures="M26,14 L38,14 L50,56 L14,56 Z"/>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <GeometryDrawing Brush="#F5D250">
                            <GeometryDrawing.Geometry>
                                <GeometryGroup>
                                    <RectangleGeometry Rect="31,18,3,8"/>
                                    <RectangleGeometry Rect="31,30,3,8"/>
                                    <RectangleGeometry Rect="31,42,3,8"/>
                                </GeometryGroup>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <GeometryDrawing Brush="#2EA05A">
                            <GeometryDrawing.Geometry>
                                <RectangleGeometry Rect="14,6,36,18" RadiusX="5" RadiusY="5"/>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingGroup>
                </DrawingImage.Drawing>
            </DrawingImage>
            <!-- IB put (plavi akcenat) -->
            <DrawingImage x:Key="RoadIBImage">
                <DrawingImage.Drawing>
                    <DrawingGroup>
                        <GeometryDrawing Brush="#2A323F">
                            <GeometryDrawing.Geometry>
                                <RectangleGeometry Rect="0,0,64,64" RadiusX="10" RadiusY="10"/>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <GeometryDrawing Brush="#46505F">
                            <GeometryDrawing.Geometry>
                                <PathGeometry Figures="M26,14 L38,14 L50,56 L14,56 Z"/>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <GeometryDrawing Brush="#F5D250">
                            <GeometryDrawing.Geometry>
                                <GeometryGroup>
                                    <RectangleGeometry Rect="31,18,3,8"/>
                                    <RectangleGeometry Rect="31,30,3,8"/>
                                    <RectangleGeometry Rect="31,42,3,8"/>
                                </GeometryGroup>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <GeometryDrawing Brush="#367ECC">
                            <GeometryDrawing.Geometry>
                                <RectangleGeometry Rect="14,6,36,18" RadiusX="5" RadiusY="5"/>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingGroup>
                </DrawingImage.Drawing>
            </DrawingImage>
            <!-- Status: normalno -->
            <DrawingImage x:Key="StatusOkImage">
                <DrawingImage.Drawing>
                    <DrawingGroup>
                        <GeometryDrawing Brush="#2EA05A">
                            <GeometryDrawing.Geometry>
                                <EllipseGeometry Center="32,32" RadiusX="30" RadiusY="30"/>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <GeometryDrawing>
                            <GeometryDrawing.Pen><Pen Brush="White" Thickness="7"/></GeometryDrawing.Pen>
                            <GeometryDrawing.Geometry>
                                <PathGeometry Figures="M18,33 L28,44 L47,22"/>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingGroup>
                </DrawingImage.Drawing>
            </DrawingImage>
            <!-- Status: opasnost -->
            <DrawingImage x:Key="StatusAlarmImage">
                <DrawingImage.Drawing>
                    <DrawingGroup>
                        <GeometryDrawing Brush="#D64545">
                            <GeometryDrawing.Geometry>
                                <EllipseGeometry Center="32,32" RadiusX="30" RadiusY="30"/>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <GeometryDrawing Brush="White">
                            <GeometryDrawing.Geometry>
                                <GeometryGroup>
                                    <RectangleGeometry Rect="28,14,8,24" RadiusX="4" RadiusY="4"/>
                                    <EllipseGeometry Center="32,46" RadiusX="4.5" RadiusY="4.5"/>
                                </GeometryGroup>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingGroup>
                </DrawingImage.Drawing>
            </DrawingImage>
            <!-- Logo aplikacije -->
            <DrawingImage x:Key="LogoImage">
                <DrawingImage.Drawing>
                    <DrawingGroup>
                        <GeometryDrawing Brush="#367ECC">
                            <GeometryDrawing.Geometry>
                                <RectangleGeometry Rect="0,0,64,64" RadiusX="14" RadiusY="14"/>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <GeometryDrawing Brush="White">
                            <GeometryDrawing.Geometry>
                                <GeometryGroup>
                                    <EllipseGeometry Center="20,22" RadiusX="6" RadiusY="6"/>
                                    <EllipseGeometry Center="44,22" RadiusX="6" RadiusY="6"/>
                                    <EllipseGeometry Center="32,46" RadiusX="6" RadiusY="6"/>
                                    <RectangleGeometry Rect="18,21,28,3"/>
                                    <RectangleGeometry Rect="19,22,3,24"/>
                                    <RectangleGeometry Rect="42,22,3,24"/>
                                </GeometryGroup>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingGroup>
                </DrawingImage.Drawing>
            </DrawingImage>

            <!-- ============ PALETA BOJA ============ -->
            <SolidColorBrush x:Key="BackgroundDark" Color="#1E2530"/>
            <SolidColorBrush x:Key="PanelBrush" Color="#2A323F"/>
            <SolidColorBrush x:Key="SurfaceBrush" Color="#EEF1F6"/>
            <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="AccentBrush" Color="#367ECC"/>
            <SolidColorBrush x:Key="AccentDarkBrush" Color="#2A5FA0"/>
            <SolidColorBrush x:Key="SuccessBrush" Color="#2EA05A"/>
            <SolidColorBrush x:Key="DangerBrush" Color="#D64545"/>
            <SolidColorBrush x:Key="TextDarkBrush" Color="#1E2530"/>
            <SolidColorBrush x:Key="TextMutedBrush" Color="#6B7280"/>
            <SolidColorBrush x:Key="FieldBorderBrush" Color="#D3D9E3"/>

            <FontFamily x:Key="AppFont">Segoe UI</FontFamily>

            <!-- ============ DUGMAD ============ -->
            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="16,8"/>
                <Setter Property="Margin" Value="4"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}"
                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{StaticResource AccentDarkBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="border" Property="Background" Value="#9AA7B8"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}"
                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#B83737"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="border" Property="Background" Value="#9AA7B8"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}"
                                    CornerRadius="6" BorderBrush="#3C4858" BorderThickness="1"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#34404F"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="NavButton" TargetType="Button">
                <Setter Property="Foreground" Value="#C7D0DC"/>
                <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Padding" Value="14,12"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="Transparent" CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#34404F"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ============ TEKSTUALNA POLJA + VALIDACIJA ============ -->
            <Style x:Key="InputBox" TargetType="TextBox">
                <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Padding" Value="8,6"/>
                <Setter Property="BorderBrush" Value="{StaticResource FieldBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Validation.ErrorTemplate">
                    <Setter.Value>
                        <ControlTemplate>
                            <Border BorderBrush="{StaticResource DangerBrush}" BorderThickness="1.5" CornerRadius="4">
                                <AdornedElementPlaceholder/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ErrorText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Margin" Value="2,2,0,4"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="2,0,0,3"/>
            </Style>

            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextDarkBrush}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
            </Style>

            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource CardBrush}"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="16"/>
                <Setter Property="Margin" Value="0,0,0,12"/>
                <Setter Property="BorderBrush" Value="{StaticResource FieldBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>

            <!-- ============ DATA TEMPLATE-i: VM -> View ============ -->
            <DataTemplate DataType="{x:Type vm:NetworkEntitiesViewModel}">
                <views:NetworkEntitiesView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:NetworkDisplayViewModel}">
                <views:NetworkDisplayView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:MeasurementGraphViewModel}">
                <views:MeasurementGraphView/>
            </DataTemplate>

        </ResourceDictionary>
    </Application.Resources>
</Application>
