<Window x:Class="NetworkService.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NetworkService"
        xmlns:undo="clr-namespace:NetworkService.Undo"
        mc:Ignorable="d"
        Title="Traffic Monitoring System - NetworkService" Height="760" Width="1180"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceBrush}"
        FontFamily="{StaticResource AppFont}">

    <!-- ============ PRECICE (CG4: precice za navigaciju i Undo) ============ -->
    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="D1" Command="{Binding NavigateEntitiesCommand}"/>
        <KeyBinding Modifiers="Control" Key="D2" Command="{Binding NavigateDisplayCommand}"/>
        <KeyBinding Modifiers="Control" Key="D3" Command="{Binding NavigateGraphCommand}"/>
        <KeyBinding Modifiers="Control" Key="Z" Command="{Binding UndoLastCommand}"/>
        <KeyBinding Modifiers="Control+Shift" Key="Z" Command="{Binding UndoAllCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== HEADER ===== -->
        <Border Grid.Row="0" Background="{StaticResource BackgroundDark}">
            <Grid Margin="18,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="{StaticResource LogoImage}" Width="30" Height="30"/>
                    <TextBlock Text="Traffic Monitoring System" Foreground="White"
                               FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <Border Background="#34404F" CornerRadius="4" Padding="8,3" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="CG4 · T3 (Dnevni saobraćaj) · G2 · P1" Foreground="#9FB4CC" FontSize="11"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="{Binding CurrentViewTitle}" Foreground="#9FB4CC" FontSize="13"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ===== BODY ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="250"/>
            </Grid.ColumnDefinitions>

            <!-- LEVI MENI -->
            <Border Grid.Column="0" Background="{StaticResource PanelBrush}">
                <StackPanel Margin="12,18">
                    <TextBlock Text="NAVIGACIJA" Foreground="#6B7B8F" FontSize="11" FontWeight="Bold" Margin="6,0,0,10"/>
                    <Button Style="{StaticResource NavButton}" Command="{Binding NavigateEntitiesCommand}"
                            ToolTip="Tabelarni prikaz entiteta (Ctrl+1)">
                        <TextBlock><Run Text="Network Entities View"/><LineBreak/><Run Text="Ctrl+1" FontSize="10" Foreground="#6B7B8F"/></TextBlock>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding NavigateDisplayCommand}"
                            ToolTip="Drag&amp;Drop mreža entiteta (Ctrl+2)">
                        <TextBlock><Run Text="Network Display View"/><LineBreak/><Run Text="Ctrl+2" FontSize="10" Foreground="#6B7B8F"/></TextBlock>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding NavigateGraphCommand}"
                            ToolTip="Grafikon merenja (Ctrl+3)">
                        <TextBlock><Run Text="Measurement Graph View"/><LineBreak/><Run Text="Ctrl+3" FontSize="10" Foreground="#6B7B8F"/></TextBlock>
                    </Button>

                    <Border Height="1" Background="#3C4858" Margin="6,16"/>
                    <TextBlock Text="UNDO" Foreground="#6B7B8F" FontSize="11" FontWeight="Bold" Margin="6,0,0,8"/>
                    <Button Style="{StaticResource GhostButton}" Command="{Binding UndoLastCommand}"
                            Content="↶  Undo (Ctrl+Z)" ToolTip="Poništi poslednju akciju"/>
                    <Button Style="{StaticResource GhostButton}" Command="{Binding UndoAllCommand}"
                            Content="↶↶  Undo sve (Ctrl+Shift+Z)" ToolTip="Poništi sve izvršene akcije"/>
                </StackPanel>
            </Border>

            <!-- CENTRALNI SADRZAJ -->
            <Border Grid.Column="1" Padding="18">
                <ContentControl Content="{Binding CurrentViewModel}"/>
            </Border>

            <!-- DESNA HISTORY PALETA (CG4) -->
            <Border Grid.Column="2" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource FieldBorderBrush}" BorderThickness="1,0,0,0">
                <DockPanel Margin="14,16">
                    <TextBlock DockPanel.Dock="Top" Text="HISTORY" FontWeight="Bold" FontSize="13"
                               Foreground="{StaticResource TextDarkBrush}"/>
                    <TextBlock DockPanel.Dock="Top" Text="Sve izvršene akcije" Foreground="{StaticResource TextMutedBrush}"
                               FontSize="11" Margin="0,2,0,10"/>
                    <Border DockPanel.Dock="Bottom" Height="1" Background="{StaticResource FieldBorderBrush}" Margin="0,8"/>
                    <TextBlock DockPanel.Dock="Bottom" Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                               Text="{Binding History.Count, StringFormat=Ukupno akcija: {0}}"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding History}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type undo:IUndoableAction}">
                                    <Border Background="#F4F6F9" CornerRadius="5" Padding="8,6" Margin="0,0,0,5">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="6" Height="6" CornerRadius="3" Background="{StaticResource AccentBrush}"
                                                    VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                                                       FontSize="12" Foreground="{StaticResource TextDarkBrush}" Width="170"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ===== TOAST NOTIFIKACIJE (overlay, bez MessageBox-a) ===== -->
        <ItemsControl ItemsSource="{Binding Notifications}" Grid.RowSpan="2"
                      HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,24"
                      Width="320" IsHitTestVisible="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border CornerRadius="8" Margin="0,6,0,0" Padding="14,10"
                            Background="White" BorderThickness="0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.25"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" CornerRadius="3" Background="{Binding Type, Converter={StaticResource ToastTypeToBrush}}" Margin="0,0,10,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextDarkBrush}"/>
                                <TextBlock Text="{Binding Message}" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
