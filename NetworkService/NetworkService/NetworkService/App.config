<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
    <appSettings>
        <!-- Opciona apsolutna putanja do MeteringSimulator.exe. Ako se ostavi prazno,
             aplikacija sama trazi simulator na uobicajenim relativnim lokacijama. -->
        <add key="SimulatorPath" value="" />
    </appSettings>
</configuration>
